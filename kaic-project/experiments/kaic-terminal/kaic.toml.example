# Скопируй этот файл как kaic.toml в корень проекта, который хочешь открыть,
# и подставь свои пути к моделям.
#
# kaic.toml машинно-специфичен (абсолютные пути) и не должен попадать в
# репозиторий — держи его в .gitignore.

# Модели задаются ОТДЕЛЬНО для каждой роли. Это не избыточность: роли
# предъявляют к модели разные требования, и это установлено экспериментально.
[models]

# Planner (агентный слой) — ОБЯЗАТЕЛЬНО instruction-tuned non-reasoning модель.
#
# Reasoning-модель здесь не работает в принципе: она открывает <think>,
# расходует весь бюджет токенов на рассуждение и не выдаёт формат
# STATUS:/PLAN:, который ждёт гейт. Это не чинится ни текстовой инструкцией в
# промпте, ни GBNF-грамматикой на префикс (грамматика запрещает начать с
# <think>, но модель просто переносит рассуждение за навязанный префикс).
# Диагностика обошлась в ~124 минуты реального инференса — не повторяй её.
#
# Проверено и работает: gemma-4-E4B-it (instruction-tuned) — Ready с первого
# прогона, содержательный план, генерация завершается сама.
planner = "C:/путь/к/instruction-tuned-модели.gguf"

# REPL (интерактивный диалог с человеком) — требования мягче: reasoning-
# поведение диалогу не мешает, а задержка ответа важнее, чем для фонового
# вызова Planner'а, поэтому здесь уместна модель поменьше.
repl = "C:/путь/к/модели-для-диалога.gguf"

# Известные локальные альтернативы (из скана кэша LM Studio) — как ориентир,
# а не как рекомендация. Размер указан для квантованного файла:
#
#   1.7  GiB  mythos-nano-Q4_K_S            reasoning; для repl годится, для planner НЕТ
#   5.0  GiB  gemma-4-E4B-it-Q4_K_M         instruction-tuned; проверена на planner
#   5.0  GiB  Qwable-9B-...-OBLITERATED     9B-мёрдж, поведение не проверялось
#   5.2  GiB  Qwythos-9B-Claude-Mythos-5    семья Mythos, вероятно reasoning
#  11.3  GiB  gpt-oss-20b-MXFP4             reasoning, тяжёлая для CPU
#  14-23 GiB  GLM-4.7-Flash, GLM-5.1-DA,    на CPU нереалистично медленные,
#             gemma-4-26B, Qwen3.6-40B,     половина из них явно reasoning
#             Nemotron-3-Nano-Omni
#
# На CPU этой машины цена примерно линейна размеру файла: ~5.7 с/токен для
# 1.7 GiB против ~9.3 с/токен для 5.0 GiB.

# Необязательные поля — если не указаны, используются значения по умолчанию:
temperature = 0.7
max_tokens = 1024
context = 4096
n_gpu_layers = 0
